{
    "problemMatcher": [
        {
            "owner": "match-syntax",
            "pattern": [
                {
                    "regexp": "^(mixed line endings \\(.*?\\)): (.*)$",
                    "message": 1,
                    "file": 2
                }
            ]
        },
        {
            "owner": "failed-to-parse",
            "pattern": [
                {
                    "regexp": "^failed to parse (.*?): (.*?) at line (\\d+), column (\\d+)$",
                    "file": 1,
                    "message": 2,
                    "line": 3,
                    "column": 4
                }
            ]
        }
    ]
}
